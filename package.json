{
    "name":  "picturereader",
    "version":  "2.0.1",
    "description":  "Unified image understanding plugin for DeepSeek Harness (DSH). Fuses frame-free pseudo-multimodal reading (pixel scan + OCR + sample) with an optional external vision API bridge (local llama-server / LM Studio / any OpenAI-compatible endpoint) for full semantic understanding. No extra plugin needed.",
    "type":  "module",
    "main":  "src/index.js",
    "exports":  {
                    ".":  "./src/index.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "src",
                  "scripts",
                  "cordis.patch.yml",
                  "skills",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "test":  "node --test"
                },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "image",
                     "vision",
                     "pixels",
                     "ascii",
                     "ocr",
                     "paddleocr",
                     "hue",
                     "multimodal",
                     "vlm",
                     "vision-analyze",
                     "llm-vision"
                 ],
    "license":  "MIT",
    "author":  "picturereader",
    "engines":  {
                    "node":  "^22.19 || \u003e=24"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "dependencies":  {
                         "jpeg-js":  "^0.4.4",
                         "omggif":  "^1.0.10",
                         "pngjs":  "^7.0.0"
                     }
}
